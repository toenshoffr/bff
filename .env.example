# Copy to .env and adjust for your environment.

PORT=3000
NODE_ENV=development

# Origin of the Angular dev server / deployed SPA. Must be exact (scheme+host+port).
FRONTEND_ORIGIN=http://localhost:4200

# Spring Boot REST API
API_BASE_URL=http://localhost:8080
API_TIMEOUT_MS=10000
# Path prefix on the BFF that is proxied through to API_BASE_URL, e.g. a request to
# BFF /api/orders is forwarded to API_BASE_URL/orders.
API_PROXY_PATH=/api

# Comma-separated list of enabled auth methods: "password", "oauth", or "password,oauth"
AUTH_METHODS=password,oauth

# How many hops of X-Forwarded-* headers to trust (Express's `trust proxy` setting).
# "false" (default) trusts none — safest if the BFF might ever be reached directly.
# Set to the number of reverse proxies actually in front of it (usually "1") once
# deployed behind one, or a keyword Express understands ("loopback", "uniquelocal").
TRUST_PROXY=false

# Session cookie (this is the ONLY thing the browser ever sees)
SESSION_SECRET=change-me-to-a-long-random-string
COOKIE_NAME=bff.sid
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_MAX_AGE_MS=28800000

# Set to false to disable the CSRF double-submit check (e.g. for Postman/curl
# testing without fetching /auth/csrf first). Testing only — refused at startup
# when NODE_ENV=production.
CSRF_PROTECTION_ENABLED=true

# POST /auth/login throttling, per (client IP + attempted username).
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=60000

# --- Username/password auth ---
# The BFF forwards credentials to these Spring Boot endpoints and expects a JSON
# response containing accessToken/refreshToken/expiresIn (camelCase or snake_case).
PASSWORD_LOGIN_PATH=/api/auth/login
PASSWORD_REFRESH_PATH=/api/auth/refresh

# --- OAuth client (Authorization Code + PKCE) ---
OAUTH_AUTHORIZATION_ENDPOINT=https://idp.example.com/oauth2/authorize
OAUTH_TOKEN_ENDPOINT=https://idp.example.com/oauth2/token
OAUTH_END_SESSION_ENDPOINT=https://idp.example.com/oauth2/logout
OAUTH_CLIENT_ID=bff-client
OAUTH_CLIENT_SECRET=change-me
# Must point back at this BFF, not the Angular app.
OAUTH_REDIRECT_URI=http://localhost:3000/auth/oauth/callback
OAUTH_SCOPES=openid profile email
# Where to send the browser after a successful OAuth login (typically the SPA's URL).
OAUTH_POST_LOGIN_REDIRECT=http://localhost:4200
